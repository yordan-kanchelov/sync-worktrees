node_modules/
dist/
*.log
.DS_Store
.env
.env.local
coverage/
.nyc_output/
*.tsbuildinfo

# Local Codex CLI config
.codex/

# npm pack artifacts
*.tgz

# Changesets temp files
.changeset/_tmp.md
.changeset/pre.json

# User config files (but keep examples)
sync-worktrees.config.js

# Astro site build artifacts (site/scripts/copy-assets.mjs copies the demo and launch videos in from assets/)
site/.astro/
site/public/demo.mp4
site/public/demo-poster.webp
site/public/launch.mp4
site/public/launch-poster.jpg

# MCP stdio integration-test build dirs (bundled inside the repo so the spawned
# server resolves node_modules; removed in the test's finally block)
.mcp-stdio-test-*

# E2E scratch trees (real git repositories, created under the repo root by
# clone-mode.e2e and config-file.e2e; removed when the run finishes). Ignored
# so a suite in flight does not make the working tree look dirty, and so a
# stray `git add -A` during one cannot commit a throwaway repository.
tmp-e2e-*/
