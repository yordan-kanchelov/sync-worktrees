{
  "name": "sync-worktrees",
  "version": "5.1.1",
  "type": "module",
  "description": "Automatically synchronize Git worktrees with remote branches - perfect for multi-branch development workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sync-worktrees": "bin/sync-worktrees.js",
    "sync-worktrees-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "node esbuild.config.js && tsc --emitDeclarationOnly",
    "start": "node bin/sync-worktrees.js",
    "watch": "tsc --watch",
    "lint": "eslint '**/*.{js,cjs,mjs}'",
    "lint:fix": "eslint '**/*.{js,cjs,mjs}' --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:e2e:local": "npm run build && vitest run src/__tests__/e2e",
    "test:e2e:network": "npm run build && RUN_NETWORK_E2E=true vitest run src/__tests__/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "pnpm run build && pnpm run lint && pnpm run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "keywords": [
    "git",
    "worktree",
    "sync",
    "automation",
    "branch-management",
    "git-worktrees",
    "devops"
  ],
  "author": "Yordan Kanchelov <yordan.kanchelov@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordan-kanchelov/sync-worktrees.git"
  },
  "bugs": {
    "url": "https://github.com/yordan-kanchelov/sync-worktrees/issues"
  },
  "homepage": "https://github.com/yordan-kanchelov/sync-worktrees#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cli-table3": "^0.6.5",
    "cron-parser": "^5.6.2",
    "fast-folder-size": "^2.4.0",
    "glob": "^13.0.6",
    "ink": "^7.1.1",
    "node-cron": "^4.6.0",
    "p-limit": "^7.3.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "simple-git": "^3.36.0",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fast-folder-size",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
