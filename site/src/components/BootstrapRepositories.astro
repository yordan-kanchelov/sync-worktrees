---
import { getCollection } from "astro:content";
import { Code } from "astro:components";
import CopyButton from "./CopyButton.astro";
import Icon from "./Icon.astro";
import { inlineCodeToHtml } from "../lib/markdown-inline";

const features = (await getCollection("features"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);

const configCode = `// sync-worktrees.config.js

/** @satisfies {import("sync-worktrees").SyncWorktreesConfig} */
const config = {
  defaults: {
    branchInclude: ["main", "feature/*", "release/*"],
    branchExclude: ["feature/wip-*"],
  },
  repositories: [
    {
      name: "frontend",
      repoUrl: "git@github.com:company/frontend.git",
      worktreeDir: "./worktrees/frontend",
    },
    {
      name: "backend",
      repoUrl: "git@github.com:company/backend.git",
      worktreeDir: "./worktrees/backend",
      branchMaxAge: "6m",
    },
  ],
};

export default config;`;

const highlights: { title: string; body: string; href?: string; linkText?: string }[] = [
  {
    title: "Selected branches only",
    body: "Keep main, feature, and release branches while excluding wip branches or stale branches by age.",
  },
  {
    title: "Stable paths",
    body: "Every branch has a folder of its own, at the same path on every machine — the default branch under its own name, the rest named after the branch with a short suffix that keeps similar names apart. `cd` into one instead of checking out and stashing.",
  },
  {
    title: "Same layout on every machine",
    body: "Commit the config to a small workspace repo of its own (a small `.gitignore` keeps out the `.bare/` and worktree folders the tool writes beside it). A new laptop or a new teammate gets the same folders, same names.",
    href: "https://github.com/yordan-kanchelov/sync-worktrees#team-workspace",
    linkText: "Team workspace in the README →",
  },
];
---
<section id="solution" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wide text-ink-500">The solution</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">
        Declare the workspace once. Get every selected branch at a stable path.
      </h2>
      <p class="mt-3 text-lg text-ink-600">
        One config. It clones what's missing, makes a worktree per selected branch, and keeps each at a predictable path.
      </p>
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-ink-500">
      Git objects are stored once per repository entry in <code class="font-mono text-xs">.bare/</code>. Anything sync removes — including a diverged checkout it replaces, its commits pinned — goes to a reversible <code class="font-mono text-xs">.trash/</code> first (30 days, <code class="font-mono text-xs">sync-worktrees trash --restore</code>).
    </p>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div class="min-w-0 overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-200 bg-ink-50 px-4 py-3">
          <div class="flex items-center gap-3">
            <span class="inline-flex size-8 items-center justify-center rounded-full border border-ink-200 bg-white text-sm font-semibold text-ink-700">
              cfg
            </span>
            <div>
              <h3 class="text-sm font-semibold text-ink-900">Create sync-worktrees.config.js</h3>
              <p class="text-xs text-ink-500">The config decides which repo branches get a folder.</p>
            </div>
          </div>
          <CopyButton value={configCode} class="text-ink-600 hover:bg-white" />
        </div>
        <div class="overflow-x-auto bg-ink-50 [&_pre]:m-0! [&_pre]:bg-transparent! [&_pre]:p-4! [&_pre]:text-[13px] [&_pre]:leading-6">
          <Code code={configCode} lang="javascript" theme="github-light" wrap />
        </div>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-ink-50 p-5">
        <div class="flex items-center gap-2 text-sm font-semibold text-ink-900">
          <Icon name="command" size={16} />
          Why this removes the tax
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {highlights.map(({ title, body, href, linkText }) => (
            <div class="flex gap-3">
              <span class="mt-1 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent-100 text-accent-700 ring-1 ring-accent-200">
                <Icon name="check" size={12} />
              </span>
              <div>
                <h4 class="text-sm font-semibold text-ink-900">{title}</h4>
                <p class="mt-1 text-sm leading-relaxed text-ink-600" set:html={inlineCodeToHtml(body)} />
                {href && (
                  <a href={href} class="mt-1 inline-block text-sm font-medium text-ink-700 underline decoration-ink-300 underline-offset-4 hover:text-ink-900">
                    {linkText}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-14 grid gap-x-12 gap-y-6 sm:grid-cols-2">
      {features.map(({ title, body }) => (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-wide text-ink-500">{title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-600" set:html={inlineCodeToHtml(body)} />
        </div>
      ))}
    </div>
  </div>
</section>
