---
import { getEntry } from "astro:content";
import { Code } from "astro:components";
import CopyButton from "./CopyButton.astro";
import { inlineCodeToHtml } from "../lib/markdown-inline";

const commands = (await getEntry("commands", "main"))!.data;

const steps = [
  {
    title: "Install",
    body: "Global npm install. Node 24+, Git (and `git-lfs` for LFS repos), macOS or Linux; `tmux` only for the TUI's open-in-terminal wizard.",
    code: commands.npmInstall,
    lang: "bash",
  },
  {
    title: "Run the init wizard",
    body: "Writes `sync-worktrees.config.js` where you run it, with your first repository in it. Add more by editing the file.",
    code: `cd ~/projects/my-sync-dir\n${commands.init}`,
    lang: "bash",
  },
  {
    title: "Launch the TUI — or sync once",
    body: "Plain command = TUI that syncs now, then hourly. `--runOnce` for CI or a cron/systemd timer.",
    code: `# interactive TUI + cron\n${commands.runTui}\n# one-shot\n${commands.runOnce}`,
    lang: "bash",
  },
];
---
<section id="quickstart" class="bg-white pb-20 sm:pb-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mt-10 max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-wide text-ink-500">Quick start</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">
        Three commands to a synced workspace.
      </h2>
    </div>

    <ol class="mt-10 max-w-3xl space-y-8">
      {steps.map((s, i) => (
        <li class="grid gap-3 sm:grid-cols-[2.5rem_1fr]">
          <div class="font-mono text-sm text-ink-400">{i + 1}</div>
          <div>
            <h3 class="text-base font-semibold text-ink-900">{s.title}</h3>
            <p class="mt-1 text-sm text-ink-600" set:html={inlineCodeToHtml(s.body)} />
            <div class="mt-3 overflow-hidden rounded-lg border border-ink-200 bg-ink-50">
              <div class="flex items-center justify-between border-b border-ink-200 px-3 py-1.5">
                <span class="font-mono text-xs text-ink-500">terminal</span>
                <CopyButton value={s.code} class="text-ink-600 hover:bg-white" />
              </div>
              <div class="[&_pre]:m-0! [&_pre]:bg-transparent! [&_pre]:px-4! [&_pre]:py-3! [&_pre]:text-[13px] [&_pre]:leading-6">
                <Code code={s.code} lang={s.lang as any} theme="github-light" wrap />
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
