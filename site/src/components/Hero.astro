---
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import CopyButton from "./CopyButton.astro";
import packageMetadata from "../../../package.json";
import { inlineCodeToHtml } from "../lib/markdown-inline";

const commands = (await getEntry("commands", "main"))!.data;
const positioning = (await getEntry("positioning", "main"))!.data;
const npmCmd = commands.npmInstall;
const packageVersion = packageMetadata.version;

// The smallest config the loader accepts: name, repoUrl and worktreeDir per entry.
const showcaseConfig = `// sync-worktrees.config.js
/** @satisfies {import("sync-worktrees").SyncWorktreesConfig} */
const config = {
  repositories: [
    { name: "frontend", repoUrl: "git@github.com:company/frontend.git", worktreeDir: "./worktrees/frontend" },
    { name: "backend", repoUrl: "git@github.com:company/backend.git", worktreeDir: "./worktrees/backend" },
  ],
};
export default config;`;

// Live star count, fetched at build time. Falls back to no count if the API is
// unreachable or rate-limited so the build never depends on network access.
let starCount: number | null = null;
try {
  const res = await fetch("https://api.github.com/repos/yordan-kanchelov/sync-worktrees", {
    signal: AbortSignal.timeout(3000),
    headers: { Accept: "application/vnd.github+json", "User-Agent": "sync-worktrees-site" },
  });
  if (res.ok) {
    const data = await res.json();
    if (typeof data.stargazers_count === "number") starCount = data.stargazers_count;
  }
} catch {
  starCount = null;
}
const starLabel =
  starCount === null ? null : starCount >= 1000 ? `${(starCount / 1000).toFixed(1)}k` : `${starCount}`;
---
<section class="relative overflow-hidden bg-white">
  <div class="mx-auto max-w-6xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-20">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
      <div>
        <a
          href="https://github.com/yordan-kanchelov/sync-worktrees"
          class="inline-flex items-center gap-2 rounded-md border border-ink-200 bg-white px-3 py-1 text-xs font-medium text-ink-700 transition hover:border-ink-400 hover:text-ink-900"
        >
          <span class="inline-block size-1.5 rounded-full bg-signal-green"></span>
          v{packageVersion} · MIT
          <span class="text-ink-400">·</span>
          <span class="inline-flex items-center gap-1">
            <Icon name="github" size={14} /> GitHub
          </span>
          <span
            id="gh-stars"
            class:list={[
              "ml-0.5 inline-flex items-center gap-1 rounded bg-ink-100 px-1.5 py-0.5 text-[11px] font-semibold text-ink-700",
              { hidden: !starLabel },
            ]}
          >
            ★ <span data-star-value>{starLabel}</span>
          </span>
        </a>

        <h1 class="mt-8 text-4xl font-semibold leading-[1.12] tracking-tight text-ink-900 sm:text-5xl lg:text-[3.4rem]">
          {positioning.heroHeadlineLine1}
          <span class="mt-1 block font-medium text-ink-500">{positioning.heroHeadlineLine2}</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
          <strong class="font-medium text-ink-900">sync-worktrees</strong>
          <span set:html={inlineCodeToHtml(positioning.heroSubhead)} />
        </p>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-500">
          {positioning.heroDiskNote}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#quickstart"
            class="inline-flex items-center gap-2 rounded-md bg-ink-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-ink-700"
          >
            Get started <Icon name="arrow-right" size={16} />
          </a>
          <span class="inline-flex items-center gap-2 font-mono text-sm text-ink-600">
            <span class="text-ink-400">$</span> {npmCmd}
            <CopyButton value={npmCmd} class="text-ink-500 hover:bg-ink-100" />
          </span>
        </div>
      </div>

      <div class="min-w-0 overflow-hidden rounded-xl border border-ink-800 bg-ink-900 text-left shadow-sm">
        <div class="flex items-center gap-1.5 border-b border-ink-800 px-4 py-2.5">
          <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="size-2.5 rounded-full bg-[#28c840]"></span>
          <span class="ml-2 font-mono text-xs text-ink-400">sync-worktrees</span>
        </div>
        <div class="space-y-1 p-4 font-mono text-xs leading-5 text-ink-200">
          <!-- Abridged real log lines from a one-shot run, in an order it can print: every repository is initialised
               (clone, default-branch worktree) before any sync starts (src/index.ts runMultipleRepositories), then the
               two syncs interleave (git.service.ts, worktree-mode-sync-runner.ts). -->
          <div class="sw-line" style="animation-delay:0s"><span class="text-ink-500">$</span> sync-worktrees --runOnce</div>
          <div class="sw-line text-ink-300" style="animation-delay:0.35s">🔄 Syncing 2 repositories...</div>
          <div class="sw-line" style="animation-delay:0.7s"><span class="text-ink-500">[frontend]</span> <span class="text-emerald-400">✅</span> Clone successful.</div>
          <div class="sw-line" style="animation-delay:1.05s"><span class="text-ink-500">[backend]</span> <span class="text-emerald-400">✅</span> Clone successful.</div>
          <div class="sw-line" style="animation-delay:1.4s"><span class="text-ink-500">[frontend]</span> Step 2: Creating 1 new worktrees...</div>
          <div class="sw-line" style="animation-delay:1.75s"><span class="text-ink-500">[frontend]</span> &nbsp;&nbsp;<span class="text-emerald-400">✅</span> Created worktree for 'feature/login'</div>
          <div class="sw-line" style="animation-delay:2.1s"><span class="text-ink-500">[backend]</span> &nbsp;&nbsp;<span class="text-emerald-400">✅</span> Created worktree for 'release/next'</div>
          <div class="sw-line mt-2 border-t border-ink-800 pt-2 text-ink-400" style="animation-delay:2.6s">worktrees/</div>
          <div class="sw-line text-ink-200" style="animation-delay:2.85s">├─&nbsp;frontend/</div>
          <div class="sw-line text-ink-400" style="animation-delay:3s">│&nbsp;&nbsp;├─&nbsp;main/</div>
          <div class="sw-line text-ink-400" style="animation-delay:3.15s">│&nbsp;&nbsp;└─&nbsp;feature-login-…/</div>
          <div class="sw-line text-ink-200" style="animation-delay:3.35s">└─&nbsp;backend/</div>
          <div class="sw-line text-ink-400" style="animation-delay:3.5s">&nbsp;&nbsp;&nbsp;├─&nbsp;main/</div>
          <div class="sw-line text-ink-400" style="animation-delay:3.65s">&nbsp;&nbsp;&nbsp;└─&nbsp;release-next-…/</div>
          <div class="sw-line pt-2 text-ink-500" style="animation-delay:4.1s"># one folder per branch, at the same path on every machine</div>
        </div>
      </div>
    </div>

    <div class="mt-12 rounded-xl border border-ink-200 bg-ink-50 p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-ink-500">One config</p>
      <pre class="mt-3 overflow-x-auto font-mono text-xs leading-6 text-ink-700">{showcaseConfig}</pre>
      <p class="mt-3 text-sm text-ink-600">
        Declare your repos once. Commit the file to a small workspace repo of its own, and every teammate and every new machine rebuilds the same workspace.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelector('a[href="https://github.com/yordan-kanchelov/sync-worktrees"]')
    ?.addEventListener("click", function () {
      window.posthog?.capture("github_link_clicked", { location: "hero" });
    });

  // Refresh the build-time star count with a live value on page load, so the
  // badge stays current between static rebuilds.
  fetch("https://api.github.com/repos/yordan-kanchelov/sync-worktrees", {
    headers: { Accept: "application/vnd.github+json" },
  })
    .then(function (res) {
      return res.ok ? res.json() : null;
    })
    .then(function (data) {
      if (!data || typeof data.stargazers_count !== "number") return;
      var badge = document.getElementById("gh-stars");
      var value = badge && badge.querySelector("[data-star-value]");
      if (!badge || !value) return;
      var n = data.stargazers_count;
      value.textContent = n >= 1000 ? (n / 1000).toFixed(1) + "k" : String(n);
      badge.classList.remove("hidden");
    })
    .catch(function () {});
</script>

<style>
  .sw-line {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sw-line {
      animation: sw-cascade 7s ease-in-out infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sw-line {
      opacity: 1;
    }
  }
  @keyframes sw-cascade {
    0%,
    4% {
      opacity: 0;
      transform: translateY(3px);
    }
    10%,
    86% {
      opacity: 1;
      transform: translateY(0);
    }
    94%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
</style>
